---
/**
 * The playground (spec §9.2, ADR-0054, ADR-0084): a full-screen editor. The bar is static, so the
 * page has its links before the editor loads; the editor itself is a client-only island.
 */
import Lockup from "../src/assets/lockup-white.svg"
import Base from "../src/layouts/Base.astro"
import Playground from "../src/playground/Playground.tsx"
// oxlint-disable-next-line import/no-unassigned-import -- Astro loads stylesheets by import
import "../src/styles/playground.css"
---

<Base title="Playground: EffectScript" description="Write EffectScript and watch every part become Effect TypeScript, live, with the real compiler running in your browser. Or paste Effect TypeScript and see it as EffectScript.">
  <div class="pg-page">
    <header class="pg-site">
      <a href="/" class="pg-brand" aria-label="EffectScript home"><Lockup height={24} width={128} /></a>
      <h1 class="pg-title">Playground</h1>
      <p class="pg-lede">Write EffectScript on the left. Every part is linked to the Effect TypeScript it becomes.</p>
      <nav class="pg-nav" aria-label="Site">
        <a href="/docs">Docs</a>
        <a href="https://github.com/EffectScript-Lang/effectscript">GitHub</a>
        <a href="https://x.com/gunta85" class="pg-follow">Follow @gunta85</a>
      </nav>
    </header>
    <Playground client:only="react" />
  </div>
</Base>
