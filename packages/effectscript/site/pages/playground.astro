---
import Follow from "../src/components/Follow.astro"
import Header from "../src/components/Header.astro"
import Base from "../src/layouts/Base.astro"
import Playground from "../src/playground/Playground.tsx"
---

<Base title="Playground: EffectScript" description="Write EffectScript and see the Effect TypeScript it compiles to, or paste Effect TypeScript and see it as EffectScript.">
  <Header />
  <main class="mx-auto max-w-7xl px-4 py-10">
    <h1 class="font-display text-3xl font-bold tracking-tight">Playground</h1>
    <p class="mt-2 max-w-3xl text-subtle">
      Edit either side. EffectScript compiles to Effect TypeScript, and Effect TypeScript converts back, both with the real compiler running in your browser.
    </p>
    <div class="mt-8">
      <Playground client:only="react" />
    </div>
    <Follow />
  </main>
</Base>
