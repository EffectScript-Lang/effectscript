---
/**
 * effectscript.dev (spec §9.2, ADR-0082): an exhibition in a dark room. Every idea gets a room with
 * one live WebGPU scene or photograph, one artifact and a placard; the chapters pin like the
 * launch film's titles. Every number and diagnostic is computed when the site is built.
 */
import CodeWindow from "../src/components/CodeWindow.astro"
import Follow from "../src/components/Follow.astro"
import Nav from "../src/components/lp/Nav.astro"
import Picture from "../src/components/lp/Picture.astro"
import Scene from "../src/components/lp/Scene.astro"
import { corpusTotals } from "../src/data/corpus.ts"
import { film, stills } from "../src/data/film.ts"
import { saving } from "../src/data/gallery.ts"
import { ceremony, ceremonySheet, mistakes, outputExample, savings, scenarios, totals } from "../src/data/lp.ts"
import { keywords, libraries, tiles, translation } from "../src/data/stdlib.ts"
import Base from "../src/layouts/Base.astro"
import { highlight } from "../src/lib/highlight.ts"
// oxlint-disable-next-line import/no-unassigned-import -- Astro loads stylesheets by import
import "../src/styles/lp.css"

const corpus = corpusTotals()
const mono = (code: string, language: "efx" | "ts" | "shell" = "efx") => highlight(code, language, "mono")
const bento = await Promise.all(tiles.map(async (t) => ({ ...t, html: await mono(t.code) })))
/** Each library construct, linked to its reference page. */
const pages: Readonly<Record<string, string>> = {
  config: "config",
  test: "test",
  api: "http",
  command: "cli",
  rpc: "rpc",
  tool: "ai",
  entity: "cluster",
  workflow: "workflow"
}
const libs = libraries.map((l) => ({ ...l, page: pages[l.name] ?? "effect" }))
const diagnosed = await Promise.all(mistakes.map(async (m) => ({ ...m, html: await mono(m.code) })))
const output = { efx: await mono(outputExample.efx), ts: await mono(outputExample.ts, "ts") }
const intentCode =
  "export schema User {\n  id: string\n  name: string\n}\n\nexport error UserNotFound { id: string }\n\nexport service Users {\n  effect find(id: string): User throws UserNotFound\n}\n\nexport effect getUser(id: string): User throws UserNotFound needs Users {\n  const user = await Users.find(id)\n  console.log(`found ${user.name}`)\n  return user\n} |> retry({ times: 3 })"
const intent = await mono(intentCode)
const header = await mono("// @effect 4.0\nexport effect greet(name: string) {\n  return `Hello, ${name}`\n}")
const install = await mono(
  "curl -fsSL https://effectscript.dev/install | sh\nefx setup     # editors and coding agents\nefx init      # in a project\nefx convert   # see what would become EffectScript",
  "shell"
)
const removed = ceremony.filter((c) => c.efx < c.effect)

---

<Base
  title="EffectScript: All of Effect. None of the ceremony."
  description="EffectScript is TypeScript with Effect as native syntax: the standard library TypeScript never got. Write async, await, throw and try; get typed errors, services, retries and tracing, compiled to idiomatic Effect TypeScript."
>
  <Nav />
  <main id="top">
    <section class="hero" aria-labelledby="hero-title" data-pointer-area data-line="hero">
      <Scene
        scene="ceremony"
        poster="hero-plate"
        alt=""
        position="40% 70%"
        eager
        data={{ sheet: JSON.stringify(ceremonySheet), pointer: "1", dpr: "1.25", "beam-y": "auto", converge: "0.76", "still-time": "6" }}
      />
      <div class="hero-copy wrap">
        <h1 id="hero-title" class="display h-hero">
          <span class="headline-fade">The standard library<br /> TypeScript never got.</span>
          <span class="dim">Now native.</span>
        </h1>
        <p class="lede">
          Write <code>async</code>, <code>await</code>, <code>throw</code> and <code>try</code>. Get typed errors, services, retries and tracing, compiled to plain, idiomatic Effect TypeScript.
        </p>
        <div class="hero-actions">
          <a class="btn btn-solid" href="/playground">Open the playground</a>
          <a class="btn btn-ghost" href="#start">Install efx</a>
          <a class="btn btn-link" href="#film">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M7.25 5.75v6.5L12.5 9z" fill="currentColor"></path></svg>
            {film.src ? `Watch the film · ${film.duration}` : "The film · premieres at launch"}
          </a>
        </div>
        <p class="hero-note mono-note" data-beam-anchor>
          <strong>{savings.effect}% fewer tokens</strong> than the Effect TypeScript it compiles to, across the ten samples below · o200k_base
        </p>
      </div>
    </section>

    <section id="film" class="theater" aria-labelledby="film-title" data-room="film" data-label="The film" data-line="film">
      <Scene scene="theater" data={{ dpr: "1", "still-time": "5" }} />
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="film-title" class="display h-room">Introducing EffectScript.</h2>
          <p class="lede">The line, given back. Every frame and every note is made from code.</p>
        </div>
        <div class="screen reveal">
          {
            film.src ? (
              <video controls preload="none" playsinline poster="/img/lp/film-monolith-plain-2560.webp">
                <source src={film.src} type="video/mp4" />
              </video>
            ) : (
              <>
                <Picture name="film-monolith-plain" alt="The ƒx mark as a monolith on a misty plain, a frame from the film" />
                <div class="screen-veil">
                  <div class="play" role="img" aria-label={`The film, ${film.duration}, premieres at launch`}>
                    <span class="play-disc">
                      <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><path d="M10 6.5v17L24 15z" fill="currentColor"></path></svg>
                    </span>
                    <span class="play-label">Premieres at launch<span>{film.duration}</span></span>
                  </div>
                </div>
              </>
            )
          }
        </div>
        <ol class="filmstrip reveal" aria-label="Stills from the film">
          {
            stills.map((s) => (
              <li>
                <figure>
                  <Picture name={s.name} alt={s.alt} sizes="(max-width: 760px) 50vw, 25vw" />
                  <figcaption>
                    <span>{s.act}</span>
                    <span>{s.time}</span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="ceremony" class="chapter" aria-labelledby="ceremony-title" data-room="ceremony" data-label="Ceremony" data-line="spine">
      <div class="chapter-stage">
        <div class="room-bg">
          <Picture name="ceremony" alt="A plain light switch in the middle of a wall covered by a machine of pipes, valves and gears" position="62% 50%" />
        </div>
        <div class="chapter-copy wrap">
          <h2 id="ceremony-title" class="display h-chapter">You wanted reliability.<br /><span class="dim">You got ceremony.</span></h2>
          <p class="lede">Typed errors, services, retries: Effect gives you all of it, and <code>yield*</code> on every line.</p>
        </div>
      </div>
    </section>

    <section class="room" aria-labelledby="ledger-title" data-line="ledger">
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="ledger-title" class="display h-room">Ceremony the compiler writes,<br /><span class="dim">so you don't.</span></h2>
        </div>
        <div class="line-stage stage-tangle" data-line-stage aria-hidden="true"></div>
        <ul class="sr-only">{removed.map((c) => <li data-ceremony={c.label}>{c.label}</li>)}</ul>
        <dl class="ledger reveal">
          {
            removed.map((c) => (
              <div>
                <dt>{c.label}</dt>
                <dd>
                  <b>{c.effect}</b> written for you · {c.efx} by you
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="cells reveal">
          <Scene scene="tokens" data={{ before: totals.effect, after: totals.efx, dpr: "2", "still-time": "3" }} />
          <div class="cells-legend">
            <dl>
              <div>
                <dt><span class="swatch"></span>EffectScript</dt>
                <dd>{totals.efx.toLocaleString("en-US")}</dd>
              </div>
              <div>
                <dt><span class="swatch ghost"></span>Effect TypeScript</dt>
                <dd>{totals.effect.toLocaleString("en-US")}</dd>
              </div>
            </dl>
            <p class="mono-note">One cell per token. The lit ones are what EffectScript still needs.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="translation" class="room" aria-labelledby="translation-title" data-room="translation" data-label="Translation" data-line="translation">
      <div class="room-bg from-right">
        <Picture name="translation" alt="A black basalt stele engraved with two columns of glyphs, one half as long as the other" position="80% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="translation-title" class="display h-room">You already know it.</h2>
          <p class="lede">If you can write async TypeScript, you can write Effect.</p>
        </div>
        <div class="pairs reveal" role="table" aria-label="async TypeScript, and the EffectScript that says the same">
          <div class="pair pair-head" role="row">
            <span role="columnheader">async TypeScript</span><span role="columnheader">EffectScript</span><span role="columnheader">What Effect gives you</span>
          </div>
          {translation.map(([a, e, what]) => (
            <div class="pair" role="row">
              <code class="pair-from" role="cell">{a}</code><code class="pair-to" role="cell">{e}</code><span class="pair-what" role="cell">{what}</span>
            </div>
          ))}
        </div>
        <p class="aside reveal">One difference: an effect runs when it's awaited, not when it's created. Forget the <code>await</code> and the compiler says so.</p>
      </div>
    </section>

    <section id="stdlib" class="room" aria-labelledby="stdlib-title" data-room="stdlib" data-label="The library" data-line="stdlib">
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="stdlib-title" class="display h-room">Everything Effect does,<br /><span class="dim">as if it was always there.</span></h2>
          <p class="lede">Errors, dependencies, concurrency, resources, schemas: each one a few words.</p>
        </div>
        <div class="line-stage stage-band" data-line-stage aria-hidden="true"></div>
        <div class="bento">
          {
            bento.map((t) => (
              <article class={`tile s${t.span} reveal`}>
                <h3 class="h-tile">{t.name}</h3>
                <pre class="code-block"><code set:html={t.html} /></pre>
              </article>
            ))
          }
        </div>
        <ul class="constructs reveal" aria-label="Effect's libraries as declarations">
          {libs.map((l) => <li><a href={`/docs/reference/${l.page}`}><code>{l.name}</code></a></li>)}
        </ul>
      </div>
    </section>

    <section id="gallery" class="room" aria-labelledby="gallery-title" data-room="gallery" data-label="The gallery" data-line="gallery">
      <div class="room-bg soft">
        <Picture name="gallery" alt="A long dark museum gallery lined with lit glass vitrines" position="50% 40%" />
      </div>
      <div class="wrap" data-gallery data-show-tokens="false">
        <div class="room-head reveal" style="max-width:64rem">
          <h2 id="gallery-title" class="display h-room">Plain. Effect. EffectScript.</h2>
          <p class="lede">The same program three ways. Every sample type-checks against Effect.</p>
        </div>
        <div class="gallery-bar flex flex-wrap items-center gap-2">
          <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Scenarios">
            {scenarios.map((s, i) => (
              <button type="button" role="tab" id={`tab-${s.id}`} tabindex={i === 0 ? "0" : "-1"} class="scenario-tab rounded-full border border-line bg-ink/70 px-3.5 py-1.5 text-sm text-subtle transition-colors hover:text-white aria-selected:border-white aria-selected:bg-white aria-selected:text-ink" aria-selected={i === 0 ? "true" : "false"} aria-controls={`scenario-${s.id}`} data-scenario={s.id}>{s.title}</button>
            ))}
          </div>
          <label class="ml-auto flex cursor-pointer items-center gap-2 text-sm text-subtle">
            <input type="checkbox" class="token-toggle accent-white" /> Show tokens
          </label>
        </div>
        <div class="mt-6">
          {scenarios.map((s, i) => (
            <div id={`scenario-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} tabindex="0" class="scenario" hidden={i !== 0} data-scenario-panel={s.id}>
              <CodeWindow title={`${s.title}: ${saving(s.panes[1].tokens, s.panes[2].tokens)}% fewer tokens than Effect TypeScript, ${saving(s.panes[0].tokens, s.panes[2].tokens)}% fewer than plain`} panes={s.panes} />
            </div>
          ))}
        </div>
        <p class="aside">Edit any of them in the <a class="text-white underline decoration-line hover:decoration-white" href="/playground">playground</a>, either side.</p>
      </div>
    </section>

    <section id="intent" class="chapter" aria-labelledby="intent-title" data-room="intent" data-label="Intent" data-line="spine">
      <div class="chapter-stage">
        <div class="room-bg">
          <Picture name="intent" alt="A single white thread passing through the eye of a needle" position="60% 50%" />
        </div>
        <div class="chapter-copy wrap">
          <h2 id="intent-title" class="display h-chapter">Say what you mean.<br /><span class="dim">The compiler writes the rest.</span></h2>
          <p class="lede">Declarations name the intent: <code>schema</code>, <code>error</code>, <code>service</code>, <code>config</code>, <code>api</code>, <code>test</code>.</p>
        </div>
      </div>
    </section>

    <section class="room" aria-labelledby="intent-file-title" data-line="intent">
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="intent-file-title" class="display h-room">One file, read for its intent.</h2>
          <p class="lede">What it returns, how it fails, what it needs: all in the signature.</p>
        </div>
      </div>
      <div class="channels reveal" role="img" aria-label="Three rails, success, error and requirements, merging into one Effect type">
        <Scene scene="channels" data={{ dpr: "2", merge: "0.58", "still-time": "6" }} />
        <ul class="channel-keys" aria-hidden="true">
          <li class="pass" style="top:22%">✓ A · succeeds with <b>User</b></li>
          <li class="fail" style="top:50%">! E · can fail with <b>UserNotFound</b></li>
          <li class="need" style="top:78%">◇ R · needs <b>Users</b></li>
        </ul>
        <p class="channel-type" aria-hidden="true">Effect&lt;User, UserNotFound, Users&gt;</p>
      </div>
      <div class="wrap">
        <div class="annotated">
          <pre class="code-block big reveal"><code set:html={intent} /></pre>
          <ol class="notes reveal">
            <li data-find="schema User"><code>schema</code><span>A type and its decoder.</span></li>
            <li data-find="error UserNotFound"><code>error</code><span>A failure you can catch by name.</span></li>
            <li data-find="): User" data-tone="pass"><code class="pass">✓ User</code><span>What it returns.</span></li>
            <li data-find="throws UserNotFound needs" data-tone="fail"><code class="fail">! throws</code><span>What can go wrong.</span></li>
            <li data-find="needs Users" data-tone="need"><code class="need">◇ needs</code><span>What it depends on.</span></li>
            <li data-find="await Users"><code>await</code><span>Runs an effect.</span></li>
            <li data-find="console.log"><code>console.log</code><span>Logs inside its span.</span></li>
            <li data-find="retry({ times: 3 })"><code>|&gt; retry</code><span>Policy, not plumbing.</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section id="agents" class="room" aria-labelledby="agents-title" data-room="agents" data-label="Agents" data-line="agents" data-ratio={String(totals.efx / totals.effect)} data-before={`Effect TypeScript · ${totals.effect.toLocaleString("en-US")}`} data-after={`EffectScript · ${totals.efx.toLocaleString("en-US")}`}>
      <div class="room-bg">
        <Picture name="agents" alt="A vast dark reading room with hundreds of identical lamps, each lighting one page" position="70% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="agents-title" class="display h-room">“I don't read the code anymore.”<br /><span class="dim">Fine. Your agents do.</span></h2>
          <p class="lede">Abstractions are what keep a program right when nobody reads every line.</p>
        </div>
        <div class="tapes reveal">
          <p class="big-number">{savings.effect}%<span>fewer tokens, same intent</span></p>
          <div class="line-stage stage-tapes" data-line-stage aria-hidden="true"></div>
          <p class="mono-note">o200k_base tokens on the ten samples. Models haven't seen <code>.efx</code> in training yet: we measure how well they write it.</p>
        </div>
        <ul class="facts-list reveal">
          <li><b>Output agents know.</b> Idiomatic Effect v4, one shape per construct.</li>
          <li><b>A skill in every agent.</b> <code>efx setup</code>: Claude Code, Codex, Cursor, Gemini CLI, opencode.</li>
          <li><b>Mistakes caught as they're written</b>, each with a fix an agent can apply.</li>
          <li><b>Docs agents can read.</b> <a class="text-white underline decoration-line hover:decoration-white" href="/llms.txt">llms.txt</a>, and Effect's guide in EffectScript: {corpus.resugared.toLocaleString("en-US")} re-sugared examples, counted with the EffectScript parser.</li>
        </ul>
      </div>
    </section>

    <section id="output" class="room" aria-labelledby="output-title" data-room="output" data-label="Output" data-line="output">
      <div class="room-bg">
        <Picture name="output" alt="A glass prism turning a haze of light into one straight beam" position="66% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="output-title" class="display h-room">Compiles to JavaScript.<br /><span class="dim">Like TypeScript did.</span></h2>
          <p class="lede">No new runtime, no wasm blob. Readable Effect, then the JavaScript your bundler makes.</p>
        </div>
        <div class="line-stage stage-pipeline" data-line-stage>
          <ol class="sr-only" aria-label="The compilation pipeline">
            <li data-node="users.efx">users.efx: what you and your agents write</li>
            <li data-node="users.ts">users.ts: idiomatic Effect v4, with source maps</li>
            <li data-node="users.js">users.js: plain JavaScript from your bundler</li>
          </ol>
        </div>
        <div class="compare reveal">
          <div>
            <p class="pane-head"><b>users.efx</b><span>{outputExample.efxTokens} tokens</span></p>
            <pre class="code-block"><code set:html={output.efx} /></pre>
          </div>
          <div>
            <p class="pane-head"><b>users.ts, compiled when this page was built</b><span>{outputExample.tsTokens} tokens</span></p>
            <pre class="code-block"><code set:html={output.ts} /></pre>
          </div>
        </div>
        <ul class="checks reveal">
          <li><strong>Runs in your browser.</strong> The compiler is plain JavaScript.</li>
          <li><strong>Errors point at your file.</strong> Source maps back to every <code>.efx</code> line.</li>
          <li><strong>Two-way.</strong> <code>efx convert</code> turns Effect TypeScript into EffectScript.</li>
        </ul>
      </div>
    </section>

    <section id="strict" class="room" aria-labelledby="strict-title" data-room="strict" data-label="Strict" data-line="strict">
      <div class="room-bg">
        <Picture name="strict" alt="A machinist's steel square, feeler gauges and a gauge block on black granite" position="72% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="strict-title" class="display h-room">Stricter than TypeScript.</h2>
          <p class="lede">It sees what TypeScript can't, and says how to fix it. Real messages, from this build.</p>
        </div>
        <div class="diagnostics">
          {
            diagnosed.map((m) => (
              <article class="diagnostic reveal" data-flags={m.diagnostics.map((d) => `${d.line}:${d.severity}`).join(" ")}>
                <h3>{m.title}</h3>
                <pre class="code-block"><code set:html={m.html} /></pre>
                {m.diagnostics.map((d) => (
                  <p class={`problem ${d.severity}`}>
                    <span class={`sev ${d.severity}`}>{d.severity === "error" ? "! error" : "▲ warning"}</span>
                    <b>{d.code}</b>
                    {d.message}
                    {d.hint && <span class="hint">→ {d.hint}</span>}
                  </p>
                ))}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="extensions" class="room" aria-labelledby="extensions-title" data-room="extensions" data-label="Extensions" data-extensions data-line="extensions">
      <div class="room-bg from-right">
        <Picture name="extensions" alt="A dark wall of recessed niches, some holding a white stone module that fits exactly" position="78% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <p class="roadmap">▲ Roadmap: not shipped, syntax may change</p>
          <h2 id="extensions-title" class="display h-room">Extensions, not dialects.</h2>
          <p class="lede">Switch them on per project. None claims another's syntax.</p>
        </div>
        <div class="ext-row">
          <div class="line-stage stage-ring" data-line-stage aria-hidden="true"></div>
          <div class="ext">
            {
              keywords.extensions.map((x) => (
                <button type="button" class="ext-card reveal" aria-pressed="false" data-ext={x.id}>
                  <span class="ext-top">
                    <span class="h-tile">{x.name}</span>
                    <span class="switch" aria-hidden="true"></span>
                  </span>
                  <span class="ext-on">On {x.on} · adds {x.adds.join(", ")}</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="superset" class="room" aria-labelledby="superset-title" data-room="superset" data-label="Superset" data-line="spine">
      <div class="room-bg">
        <Picture name="superset" alt="A white marble cube resting exactly inside a clear glass cube" position="58% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="superset-title" class="display h-room">Every TypeScript file<br /><span class="dim">is already EffectScript.</span></h2>
        </div>
        <div class="superset-row">
          <ul class="facts-list reveal">
            <li><b>A superset.</b> Rename <code>.ts</code> to <code>.efx</code> and nothing changes.</li>
            <li><b>Mixed projects.</b> <code>.ts</code> and <code>.efx</code> import each other.</li>
            <li><b>No lock-in.</b> Every <code>.efx</code> compiles back. Leave any time.</li>
            <li><b>Your tools.</b> tsc, Vite, Vitest, Bun, Node, VS Code, Neovim, Helix.</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="lockstep" class="room" aria-labelledby="lockstep-title" data-room="lockstep" data-label="Lockstep" data-line="lockstep">
      <div class="room-bg from-right">
        <Picture name="lockstep" alt="An armillary sphere with two rings locked at the same angle" position="75% 50%" />
      </div>
      <div class="wrap">
        <div class="room-head reveal">
          <h2 id="lockstep-title" class="display h-room">Built on Effect.<br /><span class="dim">Versioned with it.</span></h2>
          <p class="lede">EffectScript's version names the Effect it targets.</p>
        </div>
        <div class="lock">
          <div class="dial reveal">
            <Scene scene="lockstep" data={{ dpr: "2", "still-time": "7.2" }} />
            <p class="dial-label">effect · effectscript<b>4.0</b></p>
          </div>
          <div class="reveal">
            <div class="lock-rows">
              <div class="row"><code>effectscript@4.0.x</code><span>targets <code>effect@4.0.*</code></span></div>
              <div class="row"><code>4.0.0-alpha.N</code><span><span class="pill warn">▲ alpha</span> while the language settles</span></div>
