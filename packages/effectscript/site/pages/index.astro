<script>
  import { start } from "../src/scenes/runtime.ts"
  import { factories } from "../src/scenes/scenes.ts"

  document.documentElement.classList.add("js")
  void start(factories)

  // reveals: visible by default, faded in once as they enter
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        entry.target.classList.add("in")
        reveal.unobserve(entry.target)
      }
    },
    { rootMargin: "0px 0px -8% 0px" }
  )
  for (const el of document.querySelectorAll(".reveal")) reveal.observe(el)

  // the chapter index at the right edge
  const index = document.querySelector<HTMLElement>(".chapters")
  const rooms = [...document.querySelectorAll<HTMLElement>("[data-room]")]
  if (index !== null) {
    const name = index.querySelector<HTMLElement>(".chapters-name")!
    const update = () => {
      const middle = window.innerHeight * 0.5
      let current = -1
      for (const [i, room] of rooms.entries()) if (room.getBoundingClientRect().top <= middle) current = i
      index.classList.toggle("on", current >= 0)
      if (current < 0) return
      const room = rooms[current]!
      const [num, label] = (room.dataset.label ?? "").split(" / ")
      name.textContent = `${num} / ${String(rooms.length).padStart(2, "0")}  ${label ?? ""}`
      index.style.setProperty("--progress", String((current + 1) / rooms.length))
    }
    addEventListener("scroll", update, { passive: true })
    update()
  }

  // extensions: switch them on and off; their keywords light up, and nothing else changes
  for (const room of document.querySelectorAll<HTMLElement>("[data-extensions]")) {
    for (const card of room.querySelectorAll<HTMLButtonElement>(".ext-card")) {
      card.addEventListener("click", () => {
        const on = card.getAttribute("aria-pressed") !== "true"
        card.setAttribute("aria-pressed", String(on))
        for (const k of room.querySelectorAll<HTMLElement>(`.keywords [data-ext="${card.dataset.ext}"]`)) k.classList.toggle("lit", on)
      })
    }
  }

  // the gallery's tabs (the ARIA tabs pattern) and token toggle
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>(".scenario-tab")]
    const panels = [...gallery.querySelectorAll<HTMLElement>("[data-scenario-panel]")]
    const select = (id: string) => {
      for (const tab of tabs) {
        const selected = tab.dataset.scenario === id
        tab.setAttribute("aria-selected", String(selected))
        tab.tabIndex = selected ? 0 : -1
      }
      for (const panel of panels) panel.hidden = panel.dataset.scenarioPanel !== id
    }
    for (const [i, tab] of tabs.entries()) {
      tab.addEventListener("click", () => select(tab.dataset.scenario!))
      // arrows move between tabs, Home and End jump to the ends
      tab.addEventListener("keydown", (event) => {
        const next = event.key === "ArrowRight"
          ? (i + 1) % tabs.length
          : event.key === "ArrowLeft"
          ? (i - 1 + tabs.length) % tabs.length
          : event.key === "Home"
          ? 0
          : event.key === "End"
          ? tabs.length - 1
          : undefined
        if (next === undefined) return
        event.preventDefault()
        select(tabs[next]!.dataset.scenario!)
        tabs[next]!.focus()
      })
    }
    gallery.querySelector<HTMLInputElement>(".token-toggle")?.addEventListener("change", (event) => {
      gallery.dataset.showTokens = String((event.target as HTMLInputElement).checked)
    })
  }
</script>
