---
/**
 * A VS Code-style editor window (spec §9.2): title bar, activity bar, one editor group per pane
 * (tab, gutter, minimap strip) and a status bar. Each pane also carries its code split at token
 * boundaries, shown by the "show tokens" toggle.
 */
import type { Pane } from "../data/gallery.ts"
import { highlight } from "../lib/highlight.ts"

interface Props {
  title: string
  panes: ReadonlyArray<Pane>
  /** Which pane the status bar describes (the last one by default). */
  focus?: number
}
const { focus, panes, title } = Astro.props
const focused = panes[focus ?? panes.length - 1]!
const rendered = await Promise.all(panes.map(async (pane) => ({ pane, html: await highlight(pane.code, pane.language) })))
const label = { plain: "TypeScript", effect: "Effect TypeScript", efx: "EffectScript" } as const
---

<figure class="window overflow-hidden rounded-xl border border-line bg-[#1e1e1e] shadow-2xl shadow-black/60">
  <div class="flex items-center gap-2 border-b border-black/40 bg-[#181818] px-3 py-2">
    <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
    <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
    <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    <figcaption class="mx-auto truncate font-mono text-xs text-subtle">{title}</figcaption>
  </div>
  <div class="flex">
    <div class="hidden w-11 shrink-0 flex-col items-center gap-4 bg-[#181818] py-3 sm:flex" aria-hidden="true">
      <span class="h-5 w-5 rounded-sm border-l-2 border-white/80 bg-white/10"></span>
      <span class="h-5 w-5 rounded-sm bg-white/10"></span>
      <span class="h-5 w-5 rounded-sm bg-white/10"></span>
    </div>
    <div class={`grid min-w-0 flex-1 ${panes.length === 3 ? "lg:grid-cols-3" : panes.length === 2 ? "md:grid-cols-2" : ""}`}>
      {
        rendered.map(({ html, pane }) => (
          <section class="pane min-w-0 border-black/40 lg:border-l first:border-l-0" aria-label={`${label[pane.kind]}: ${pane.name}`}>
            <div class="flex items-center justify-between border-b border-black/40 bg-[#181818]">
              <span class="border-t border-t-white/80 bg-[#1e1e1e] px-3 py-1.5 font-mono text-xs text-white">{pane.name}</span>
              <span class="tokens px-3 font-mono text-[11px] text-muted" data-count={pane.tokens}>{pane.tokens} tokens</span>
            </div>
            <div class="flex">
              <pre class="code min-w-0 flex-1 overflow-x-auto py-3 text-[12.5px] leading-[1.6]"><code set:html={html} /></pre>
              <pre class="token-view hidden min-w-0 flex-1 overflow-x-auto py-3 pl-12 pr-3 text-[12.5px] leading-[1.6] whitespace-pre"><code>{pane.pieces.map((piece, i) => <span class={i % 2 === 0 ? "tok-a" : "tok-b"}>{piece}</span>)}</code></pre>
              <div class="hidden w-10 shrink-0 bg-white/[0.03] xl:block" aria-hidden="true"></div>
            </div>
          </section>
        ))
      }
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 bg-[#181818] px-3 py-1 font-mono text-[11px] text-subtle">
    <span>{label[focused.kind]}</span>
    <span>Ln 1, Col 1</span>
    <span>UTF-8</span>
    <span class="ml-auto">o200k_base · {focused.tokens} tokens</span>
  </div>
</figure>

<style>
  .code :global(.line) {
    counter-increment: line;
  }
  .code :global(code) {
    counter-reset: line;
    display: block;
  }
  .code :global(.line)::before {
    content: counter(line);
    display: inline-block;
    width: 2.25rem;
    margin-right: 0.75rem;
    text-align: right;
    color: #6e7681;
  }
  .tok-a {
    background: rgba(147, 197, 253, 0.18);
  }
  .tok-b {
    background: rgba(253, 186, 116, 0.18);
  }
  :global([data-show-tokens="true"]) .code {
    display: none;
  }
  :global([data-show-tokens="true"]) .token-view {
    display: block;
  }
</style>
