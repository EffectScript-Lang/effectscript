// @efx no-ambient
/**
 * The `efx` command (spec §7.1): EffectScript command modules on `effect/cli`, compiled by
 * `pnpm codegen` into `main.ts` (ADR-0032).
 *
 * @since 4.0.0
 */
import { Runtime } from "effect"
import { Argument, Command, Flag } from "effect/cli"
import { check as checkProject } from "./check.ts"
import { buildProject, passthrough, printFile, version } from "./project.ts"
import { run as runFile } from "./run.ts"
import { convertProject } from "../convert/project.ts"
import { doctor as checkSetup } from "./doctor.ts"
import { initProject } from "./init.ts"

/** A command's exit code: `runMain` exits with it, without logging (Runtime.errorExitCode). */
export error ExitCode {
  code: number
  override get [Runtime.errorExitCode]() {
    return this.code
  }
  override get [Runtime.errorReported]() {
    return false
  }
}

/** Fails with the exit code unless it is 0. */
const exitWith = effect (code: number) => {
  if (code !== 0) throw new ExitCode({ code })
}

/** Compile .efx files to JavaScript and declarations */
export command build(
  /** The tsconfig.json to build @alias p */ --project: string = "tsconfig.json",
) {
  await exitWith(await promise(() => buildProject(project)))
}

/** Print a file converted to TypeScript or EffectScript */
export command print(
  /** The file to convert */ file: string,
  /** What to print: ts or efx (default: the other language) */ --to?: "ts" | "efx",
) {
  const printed = printFile(file, to._tag === "Some" ? to.value : undefined)
  process.stdout.write(printed.output)
  for (const message of printed.messages) process.stderr.write(`${message}\n`)
  await exitWith(printed.ok ? 0 : 1)
}

// `check` and `run` forward arguments after `--`: the `command` construct has no variadic form yet

/** Type-check the project, .efx files included */
export const check = Command.make("check", {
  project: Flag.String("project").pipe(Flag.withAlias("p"), Flag.optional, Flag.withDescription("The tsconfig.json to check")),
  args: Argument.String("args").pipe(Argument.variadic(), Argument.withDescription("More tsc arguments (after --)"))
}, effect ({ project, args }) => {
  const projectArgs = project._tag === "Some" ? ["-p", project.value] : []
  await exitWith(checkProject([...projectArgs, ...args]))
}) |> Command.withDescription("Type-check the project, .efx files included")

/** Run a .efx or .ts file */
export const run = Command.make("run", {
  runtime: Flag.Literals("runtime", ["node", "bun"]).pipe(Flag.optional, Flag.withDescription("node or bun (default: bun when the project has @effect/platform-bun)")),
  file: Argument.String("file").pipe(Argument.withDescription("The entry file")),
  args: Argument.String("args").pipe(Argument.variadic(), Argument.withDescription("Arguments for the program"))
}, effect ({ runtime, file, args }) => {
  await exitWith(runFile([file, ...args], runtime._tag === "Some" ? runtime.value : undefined))
}) |> Command.withDescription("Run a .efx or .ts file")

/** Convert TypeScript files with Effect to EffectScript (spec §7.5) */
export const convert = Command.make("convert", {
  paths: Argument.String("paths").pipe(Argument.variadic(), Argument.withDescription("Files or directories (default: the whole project)")),
  write: Flag.Boolean("write").pipe(Flag.withDefault(false), Flag.withDescription("Convert on a new branch, effectscript/convert (default: only report)")),
  explain: Flag.Boolean("explain").pipe(Flag.withDefault(false), Flag.withDescription("Show what stays TypeScript, and why")),
  force: Flag.Boolean("force").pipe(Flag.withDefault(false), Flag.withDescription("Allow uncommitted changes")),
  noVerify: Flag.Boolean("no-verify").pipe(Flag.withDefault(false), Flag.withDescription("Skip efx check and the tests after converting")),
  test: Flag.String("test").pipe(Flag.optional, Flag.withDescription("The test command (default: npm test, when there is a test script)"))
}, effect ({ paths, write, explain, force, noVerify, test }) => {
  const code = convertProject(process.cwd(), {
    paths,
    write,
    explain,
    force,
    verify: !noVerify,
    test: test._tag === "Some" ? test.value : undefined
  }, {
    out: (line) => process.stdout.write(`${line}\n`),
    err: (line) => process.stderr.write(`${line}\n`)
  })
  await exitWith(code)
}) |> Command.withDescription("Convert TypeScript files with Effect to EffectScript")

/** Set up this project for EffectScript */
export command init() {
  await exitWith(initProject(process.cwd(), (line) => process.stdout.write(`${line}\n`)))
}

/** Report what is installed and configured for EffectScript, and what is missing */
export command doctor() {
  await exitWith(checkSetup(process.cwd(), (line) => process.stdout.write(`${line}\n`)))
}

export const efx = Command.make("efx")
  |> Command.withDescription("EffectScript: TypeScript with Effect as native syntax")
  |> Command.withSubcommands([build, check, run, print, convert, init, doctor])

main {
  // without a command, show the help; `run`/`check` pass their arguments through (ADR-0033)
  const argv = process.argv.slice(2)
  await Command.runWith(efx, { version })(argv.length === 0 ? ["--help"] : passthrough(argv))
}
