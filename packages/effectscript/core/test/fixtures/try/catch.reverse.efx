import { Data } from "effect"

class NotFound extends Data.TaggedError("NotFound")<{}> {}
class Timeout extends Data.TaggedError("Timeout")<{}> {}

declare const load: (id: string) => Effect.Effect<string, NotFound | Timeout | Error>

effect withFallback(id: string) {
  return await gen(function*() {
    return yield* load(id)
  }).pipe(catchDefect((defect) => fail(new Cause.UnknownError(defect))), catchTags({ NotFound: (e) => gen(function*() {
    return "missing"
  }), Timeout: (e) => gen(function*() {
    return "slow"
  }) }, (e) => gen(function*() {
    return `failed: ${String(e)}`
  })))
}

effect logged(id: string) {
  let result = "none"
  await gen(function*() {
    result = yield* load(id)
  }).pipe(catchTag(["NotFound", "Timeout"], (e) => gen(function*() {
    result = e._tag
  })), ensuring(gen(function*() {
    yield* log("done")
  })))
  return result
}

effect plain(json: string) {
  return await gen(function*() {
    return JSON.parse(json) as unknown
  }).pipe(catchDefect((defect) => fail(new Cause.UnknownError(defect))), Effect.catch(() => gen(function*() {
    return null
  })))
}
