import { Data } from "effect"

class NotFound extends Data.TaggedError("NotFound")<{}> {}
class Timeout extends Data.TaggedError("Timeout")<{}> {}

declare const load: (id: string) => Effect<string, NotFound | Timeout | Error>

effect withFallback(id: string) {
  return await effect {
    return await load(id)
  } |> catchDefect((defect) => fail(new Cause.UnknownError(defect))) |> catchTags({ NotFound: (e) => effect {
    return "missing"
  }, Timeout: (e) => effect {
    return "slow"
  } }, (e) => effect {
    return `failed: ${String(e)}`
  })
}

effect logged(id: string) {
  let result = "none"
  await effect {
    result = await load(id)
  } |> catchTag(["NotFound", "Timeout"], (e) => effect {
    result = e._tag
  }) |> ensuring(effect {
    await log("done")
  })
  return result
}

effect plain(json: string) {
  return await effect {
    return JSON.parse(json) as unknown
  } |> catchDefect((defect) => fail(new Cause.UnknownError(defect))) |> Effect.catch(() => effect {
    return null
  })
}
