export effect report(name: string) {
  await log("hello", name)
  await logWarning("careful")
  const startedAt = await Clock.currentTimeMillis
  const jitter = await Random.next * 10
  const region = await Config.String("REGION").pipe(Config.withDefault(undefined)) ?? "eu"
  return { startedAt, jitter, region, debug: await Config.String("DEBUG").pipe(Config.withDefault(undefined)) }
}

export function plain() {
  console.log("not captured: outside effect code")
  return Date.now()
}
