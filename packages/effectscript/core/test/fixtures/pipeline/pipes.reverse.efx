declare const getUserName: (id: string) => Effect<string, Error>

effect loadUser(id: string) {
  return await getUserName(id)
}

const program = effect {
  return await loadUser("1")
} |> retry({ times: 3 }) |> orElseSucceed(() => "anonymous")

const viaLocal = loadUser("2")
  |> timeout("1 second")
  |> orDie

const viaPipe = getUserName("3") |> map((name) => name.length)

const hack = map(getUserName("4"), (name) => name.trim())

const twice = 21 |> % + %

const mixed = loadUser("5") |> orDie |> map(%, (s) => s.length) |> asVoid

effect awaited() {
  return await loadUser("6") |> orElseSucceed(() => "none")
}
