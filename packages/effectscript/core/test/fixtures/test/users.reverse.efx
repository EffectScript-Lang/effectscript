import { assert, describe, expect, it, layer } from "@effect/vitest"
import { Clock } from "effect"
class Users extends Context.Service<Users, {
  find(id: string): Effect<string>
}>()("fixtures/test/Users") {
  static readonly layerTest = Layer.succeed(Users, Users.of({ find: effect (id: string) => `user-${id}` }))
  static readonly find = (id: string) => Users.use((_) => _.find(id))
}

describe("Users", () => {
  it.effect("finds a user", () => effect {
    const user = await Users.find("1")
    assert.strictEqual(user, "user-1")
  } |> provide(Users.layerTest))

  it.effect("scopes resources to the test", () => effect {
    const value = await acquireRelease(succeed(1), () => Effect.void)
    assert.strictEqual(value, 1)
  })

  it.live("runs on the live clock", () => effect {
    expect(await Clock.currentTimeMillis).toBeGreaterThan(0)
  })

  it.effect.skip("is skipped", () => effect {
    return await fail("never runs")
  })
})

layer(Users.layerTest)("with a shared layer", (it) => {
  it.effect("provides the layer to every test", () => effect {
    expect(await Users.find("2")).toBe("user-2")
  })
})
