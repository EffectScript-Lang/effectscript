// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the Homebrew formula (Plan 10 Task 5, ADR-0038) > pins each macOS and glibc Linux build to its release asset and checksum 1`] = `
"# GENERATED by packages/effectscript/core/scripts/homebrew.ts in EffectScript-Lang/effect-lang.
class Effectscript < Formula
  desc "TypeScript with Effect as native syntax"
  homepage "https://effectscript.dev"
  version "4.0.0-alpha.1"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/EffectScript-Lang/effect-lang/releases/download/effectscript@4.0.0-alpha.1/efx-darwin-arm64.tar.gz"
      sha256 "1111111111111111111111111111111111111111111111111111111111111111"
    end
    on_intel do
      url "https://github.com/EffectScript-Lang/effect-lang/releases/download/effectscript@4.0.0-alpha.1/efx-darwin-x64.tar.gz"
      sha256 "2222222222222222222222222222222222222222222222222222222222222222"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/EffectScript-Lang/effect-lang/releases/download/effectscript@4.0.0-alpha.1/efx-linux-arm64.tar.gz"
      sha256 "3333333333333333333333333333333333333333333333333333333333333333"
    end
    on_intel do
      url "https://github.com/EffectScript-Lang/effect-lang/releases/download/effectscript@4.0.0-alpha.1/efx-linux-x64.tar.gz"
      sha256 "5555555555555555555555555555555555555555555555555555555555555555"
    end
  end

  def install
    bin.install "efx"
  end

  def caveats
    <<~EOS
      Start using EffectScript in a project:
        efx init      # editor plugin and scripts
        efx convert   # convert the project's TypeScript (on a new git branch)
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/efx --version")
    (testpath/"hello.efx").write("const n: number = 40 + 2\\nconsole.log(n)\\n")
    assert_equal "42", shell_output("#{bin}/efx run hello.efx").strip
  end
end
"
`;
