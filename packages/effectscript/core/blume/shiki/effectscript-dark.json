{
  "name": "effectscript-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0b0b0d",
    "editor.foreground": "#e4e4e7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8e8e96",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control.effect.efx",
        "keyword.other.throws.efx",
        "keyword.operator.pipeline.efx",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f4f4f5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "string",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "string.template"
      ],
      "settings": {
        "foreground": "#a1a1aa"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#d4d4d8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "keyword.operator.type.efx"
      ],
      "settings": {
        "foreground": "#8e8e96"
      }
    },
    {
      "scope": [
        "meta.return-type.efx",
        "meta.return-type.efx entity.name.type",
        "meta.return-type.efx entity.name.type.efx"
      ],
      "settings": {
        "foreground": "#4ade80"
      }
    },
    {
      "scope": [
        "meta.throws-clause.efx",
        "meta.throws-clause.efx entity.name.type",
        "meta.throws-clause.efx entity.name.type.efx"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    },
    {
      "scope": [
        "meta.needs-clause.efx",
        "meta.needs-clause.efx entity.name.type",
        "meta.needs-clause.efx entity.name.type.efx"
      ],
      "settings": {
        "foreground": "#60a5fa"
      }
    }
  ]
}
