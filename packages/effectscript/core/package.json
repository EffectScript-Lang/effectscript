{
  "name": "effectscript",
  "version": "4.0.0-alpha.0",
  "type": "module",
  "license": "MIT",
  "description": "EffectScript: TypeScript with Effect as native syntax",
  "homepage": "https://github.com/EffectScript-Lang/effectscript/tree/effectscript/packages/effectscript/core",
  "repository": {
    "type": "git",
    "url": "https://github.com/EffectScript-Lang/effectscript.git",
    "directory": "packages/effectscript/core"
  },
  "sideEffects": [
    "./src/register.ts",
    "./src/bun-preload.ts",
    "./dist/register.js",
    "./dist/bun-preload.js",
    "./src/cli/main.ts",
    "./dist/cli/main.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./register": "./src/register.ts",
    "./bun": "./src/bun.ts",
    "./bun-preload": "./src/bun-preload.ts",
    "./vite": "./src/vite.ts",
    "./blume/*": "./blume/*",
    "./*": "./src/*.ts",
    "./index": null
  },
  "files": [
    "grammars/*.json",
    "blume/**",
    "bin/**/*.js",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "skills/**/*.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./compiler": "./dist/compiler/index.js",
      "./register": "./dist/register.js",
      "./bun": "./dist/bun.js",
      "./bun-preload": "./dist/bun-preload.js",
      "./vite": "./dist/vite.js",
      "./blume/*": "./blume/*",
      "./*": "./dist/*.js",
      "./index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "check": "tsc -b tsconfig.json",
    "codegen": "node scripts/generate-prelude.ts && dprint fmt src/compiler/prelude/tables.ts && node scripts/compile-cli.ts && node scripts/generate-skill.ts",
    "theme-fonts": "node scripts/theme-fonts.ts"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.18.0",
    "magic-string": "^1.4.2",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "workspace:^",
    "@effect/platform-node": "workspace:^",
    "@effect/vitest": "workspace:^",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.3",
    "effect": "workspace:^",
    "fontkit": "^2.0.4",
    "shiki": "~4.4.3",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "bin": {
    "efx": "./bin/efx.js"
  },
  "peerDependencies": {
    "@effect/platform-node": "~4.0.0",
    "@effectscript/language": "workspace:*",
    "effect": "~4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@effectscript/language": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
